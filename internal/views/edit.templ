package views

// Edit autosaves every field. Each input carries data-field; site.js watches
// htmx's request lifecycle on those and drives the matching .field-status
// and the page-level save state in the edit bar.
templ Edit(p PostEdit) {
	@Base("Edit", editHead()) {
		<div class="edit-bar">
			<a class="back-link" href="/admin">&larr; all posts</a>
			<span id="save-state" class="save-state" data-state="idle" role="status" aria-live="polite">all changes saved</span>
			<a class="admin-action" href={ postPreviewURL(p.ID) }>preview &rarr;</a>
		</div>
		<div class="edit-form">
			<div class="field">
				<div class="field__head">
					<label for="title">title</label>
					@fieldStatus("title")
				</div>
				<input
					id="title"
					class="field__input field__input--title"
					type="text"
					name="title"
					placeholder="Untitled"
					autocomplete="off"
					data-field="title"
					hx-trigger="input changed delay:700ms, save-now"
					hx-patch={ postIdXURL(p.ID, "title") }
					hx-swap="none"
					hx-sync="this:replace"
					value={ p.Title }
				/>
			</div>
			<div class="field">
				<div class="field__head">
					<label for="slug">slug</label>
					@fieldStatus("slug")
				</div>
				<div class="slug-input">
					<span class="slug-input__prefix" aria-hidden="true">/posts/</span>
					@SlugInput(p.ID, p.Slug, false)
				</div>
				<p class="field__hint">follows the title until you set it here; saves when you leave the field.</p>
			</div>
			<div class="field">
				<div class="field__head">
					<label for="description">description</label>
					@fieldStatus("description")
				</div>
				<textarea
					id="description"
					class="field__input"
					name="description"
					rows="3"
					maxlength="300"
					placeholder="One or two sentences for the post card..."
					data-field="description"
					data-counter="description-count"
					hx-trigger="input changed delay:900ms, save-now"
					hx-patch={ postIdXURL(p.ID, "description") }
					hx-swap="none"
					hx-sync="this:replace"
				>{ p.Description }</textarea>
				<p class="field__hint field__hint--end"><span id="description-count">0</span>/300</p>
			</div>
			<div class="field">
				<div class="field__head">
					<label for="markdown-content">content</label>
					@fieldStatus("content")
				</div>
				<textarea
					id="markdown-content"
					name="markdown-content"
					placeholder="Write in markdown..."
					data-field="content"
					hx-trigger="mde-change delay:1200ms, save-now"
					hx-patch={ postIdXURL(p.ID, "content") }
					hx-swap="none"
					hx-sync="this:replace"
				>{ p.MarkdownContent }</textarea>
			</div>
			<p class="field__hint">autosaves as you type &middot; <kbd>ctrl</kbd>/<kbd>&#8984;</kbd> + <kbd>s</kbd> saves now</p>
		</div>
		<script>
			(() => {
				const area = document.getElementById("markdown-content");
				const easyMDE = new EasyMDE({
					element: area,
					forceSync: true,
					spellChecker: false,
					status: ["lines", "words"],
					minHeight: "320px",
					toolbar: [
						'bold', 'italic', 'heading', '|',
						'quote', 'unordered-list', 'ordered-list', '|',
						'link',
						'image',          // inserts ![](https://)
						'upload-image',   // opens file picker -> imageUploadFunction
						'|',
						'preview', 'side-by-side', 'fullscreen',
					],
					uploadImage: true,
					imageUploadFunction: (file, onSuccess, onError) => {
						const formData = new FormData();
						formData.append('file', file);

						fetch('/media', {
						  method: 'POST',
						  body: formData,
						})
						  .then((res) => {
							if (!res.ok) throw new Error('Upload failed');
							return res.json();
						  })
						  .then((data) => onSuccess(data.url))
						  .catch((err) => onError(err.message));
					  },
					  imageAccept: 'image/png, image/jpeg, image/gif, image/webp',
					  imageMaxSize: 5 * 1024 * 1024,
					  imageTexts: {
						sbInit: 'Attach files by drag and drop or paste from clipboard.',
						sbOnDragEnter: 'Drop image to upload it.',
						sbOnDrop: 'Uploading image #images_names#...',
						sbProgress: 'Uploading #file_name#: #progress#%',
						sbOnUploaded: 'Uploaded #image_name#',
						sizeUnits: ' B, KB, MB',
					  },
					  errorMessages: {
						noFileGiven: 'You must select a file.',
						typeNotAllowed: 'This image type is not allowed.',
						fileTooLarge: 'Image #image_name# is too big (#image_size#).\nMaximum file size is #image_max_size#.',
						importError: 'Something went wrong when uploading the image #image_name#.',
					  },
				});
				// the textarea is hidden behind CodeMirror; relay edits so htmx sees them
				easyMDE.codemirror.on("change", () => {
					area.dispatchEvent(new Event("input", { bubbles: true }));
					area.dispatchEvent(new Event("mde-change"));
				});
			})();
		</script>
	}
}

templ fieldStatus(field string) {
	<span class="field-status" data-status-for={ field } aria-live="polite"></span>
}

templ editHead() {
	<link rel="stylesheet" href="/static/css/easymde.min.css"/>
	// gruvbox skin — must come after easymde's own sheet
	<link rel="stylesheet" href="/static/css/editor.css"/>
	<script src="/static/js/easymde.min.js"></script>
}

// SlugInput is also sent out-of-band after a title save, since the slug
// follows the title.
templ SlugInput(id, slug string, isoob bool) {
	<input
		id="slug"
		class="field__input slug-input__field"
		type="text"
		name="slug"
		placeholder="post-slug"
		autocomplete="off"
		spellcheck="false"
		data-field="slug"
		hx-trigger="change, save-now"
		hx-patch={ postIdXURL(id, "slug") }
		hx-swap="none"
		value={ slug }
		hx-swap-oob={ isoob }
	/>
}
