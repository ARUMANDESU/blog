package views

templ Base(title string, head templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			// gruvbox bg0, light and dark — colours the mobile browser chrome
			<meta name="theme-color" content="#fbf1c7" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#282828" media="(prefers-color-scheme: dark)"/>
			// fonts: preload the two faces that carry the page chrome; Bold arrives with the rest
			<link rel="preload" href="/static/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/static/fonts/JetBrainsMono-SemiBold.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href="/static/css/bamboo.min.css"/>
			<link rel="stylesheet" href="/static/css/site.css"/>
			<script defer src="/static/js/htmx.min.js"></script>
			// favicon
			<link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png"/>
			<link rel="manifest" href="/static/site.webmanifest"/>
			if head != nil {
				@head
			}
		</head>
		<body>
			@Header()
			<main>
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

templ Header() {
	<header class="site-header">
		<a class="site-header__brand" href="/">ARUMANDESU</a>
		<nav class="site-nav">
			<a href="https://github.com/ARUMANDESU" rel="me noopener">github</a>
		</nav>
	</header>
}

templ Footer() {
	<footer class="site-footer">
		<div class="site-footer__links">
			<a href="mailto:zh.arumandes@gmail.com">email</a>
			<a href="https://github.com/ARUMANDESU" rel="me noopener">github</a>
		</div>
	</footer>
}
